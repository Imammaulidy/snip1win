# 1WIN SNIPER HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env di dalam folder core/ atau atur via menu [7] di start.sh / start.bat

# Token Bot Telegram resmi dari @BotFather
TELEGRAM_BOT_TOKEN=

# Token Cloudflare Tunnel untuk domain https://topnodtools.web.id
CLOUDFLARE_TUNNEL_TOKEN=

# Nama Tunnel Cloudflare jika menggunakan credentials file lokal
CLOUDFLARE_TUNNEL_NAME=topnodtools

# Akses Publik Mini App
PUBLIC_ACCESS=true
